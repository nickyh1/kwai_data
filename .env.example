# 快手开放平台凭证（在快手商家开放平台后台获取）
KWAI_APP_KEY=ks_your_app_key
KWAI_APP_SECRET=your_app_secret
KWAI_SIGN_SECRET=your_sign_secret

# 各店铺授权 Token（过期后需重新授权刷新）
# key 名称对应 application.yml 中 kwai.shops 下的店铺 key
KWAI_TOKEN_BIAOWANGCHANGJIA=ChF...
KWAI_TOKEN_BIAOWANGGONGCHANG=ChF...

# MongoDB 连接串（本地开发可不填，默认 localhost:27017/ERP）
# Docker Compose 启动时由 compose 自动注入，此处无需设置
# SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/ERP
